// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UniverseStatus {
  ACTIVE
  DORMANT
  COLLAPSED
  CORRUPTED
  LOST
}

enum SenderRole {
  USER
  AI
  SYSTEM
}

enum ObjectiveStatus {
  ACTIVE
  COMPLETED
  FAILED
  DISMISSED
}

enum CharacterStatus {
  ALIVE
  DEAD
  LOST
}

model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  created_at DateTime @default(now())

  userUniverses UserUniverse[]

  memorySlots MemorySlot[]

  signals Signal[]

  objectives Objective[]

  characters Character[]
}

model Universe {
  id           String   @id @default(uuid())
  name         String? 
  universeCode String   @unique
  description  String
  image        String?
  created_at   DateTime @default(now())

  userUniverses UserUniverse[]
  infos UniverseInfo[]
}

model UserUniverse {
  id         String         @id @default(uuid())
  userId     String
  universeId String
  status     UniverseStatus @default(ACTIVE)
  created_at DateTime       @default(now())

  user User @relation(fields: [userId], references: [id])

  universe Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  messages Message[]

  memorySlots MemorySlot[]

  objectives Objective[]

  signals Signal[]

  characters Character[]

  // @@unique([userId, universeId])
}

model UniverseInfo {
  id          String                @id @default(uuid())
  universeId  String
  content     String
  embedding   Unsupported("vector")
  created_at  DateTime              @default(now())

  universe Universe @relation(fields: [universeId], references: [id], onDelete:Cascade)

  @@index([universeId])
}

model Message {
  id             String     @id @default(uuid())
  userUniverseId String
  content        String
  senderRole     SenderRole
  created_at     DateTime   @default(now())

  userUniverse UserUniverse @relation(fields: [userUniverseId], references: [id],onDelete: Cascade)
}

model MemorySlot {
  id             String                @id @default(uuid())
  userId         String
  userUniverseId String
  content        String
  embedding      Unsupported("vector")
  created_at     DateTime              @default(now())
  updated_at     DateTime              @updatedAt

  user          User         @relation(fields: [userId], references: [id])
  userUniverse  UserUniverse @relation(fields: [userUniverseId], references: [id],onDelete: Cascade)

  @@index([userId])
  @@index([userUniverseId])
}

model Signal {
  id             String   @id @default(uuid())
  userId         String
  userUniverseId String
  title          String
  created_at     DateTime @default(now())

  user          User         @relation(fields: [userId], references: [id])
  userUniverse  UserUniverse @relation(fields: [userUniverseId], references: [id],onDelete: Cascade)

  @@index([userId])
  @@index([userUniverseId])
}

model Objective {
  id             String          @id @default(uuid())
  userId         String
  userUniverseId String
  title          String
  status         ObjectiveStatus
  created_at     DateTime        @default(now())

  user          User         @relation(fields: [userId], references: [id])
  userUniverse  UserUniverse @relation(fields: [userUniverseId], references: [id],onDelete: Cascade)

  @@index([userId])
  @@index([userUniverseId])
}

model Character {
  id                   String                @id @default(uuid())
  userId               String
  userUniverseId       String
  name                 String
  description          String
  descriptionEmbedding Unsupported("vector")
  status               CharacterStatus
  created_at           DateTime              @default(now())

  user          User         @relation(fields: [userId], references: [id])
  userUniverse  UserUniverse @relation(fields: [userUniverseId], references: [id])

  @@index([userId])
  @@index([userUniverseId])
}